# 对话模型（DeepSeek）
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxx

# 向量模型（DeepSeek 不提供 embeddings，需另用一家）
# 阿里云百炼：https://dashscope.aliyuncs.com/compatible-mode/v1  模型 text-embedding-v3
# OpenAI：https://api.openai.com/v1  模型 text-embedding-3-small
EMBEDDING_API_KEY=sk-xxxxxxxxxxxx
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v3
